# Admin UI / admin API password
ADMIN_KEY=change-me-admin-key

# ── PostgreSQL（docker compose 使用 pgvector/pg17，可按需修改）────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=wink123
POSTGRES_DB=tokenbank
POSTGRES_PORT=5432

# 本地裸跑 server.py 时设置（docker compose 会自动注入容器内连接串）
# DATABASE_URL=postgresql://root:wink123@localhost:5432/tokenbank

# SQLite 旧库路径（migrate_sqlite_to_pg.py 默认 server/proxy.db）
# SQLITE_PATH=./server/proxy.db

# Per-request forward timeout (seconds)
REQUEST_TIMEOUT=120

# Default Token Bank server URL (client: desktop / CLI / Docker Web UI)
TOKEN_SERVER_URL=https://tokenbank.wink.run/

# ── 启动示例 ─────────────────────────────────────────────────────────────────
# cp .env.example .env
# docker compose up -d          # 启动 postgres + proxy（API :8000，PG :5432）
# docker compose logs -f proxy  # 查看服务日志
#
# ── SQLite → PostgreSQL 迁移（docker compose 部署）──────────────────────────
# 推荐：从 docker 卷自动查找 proxy.db（支持 app_data / 旧版 db_data 卷）
# ./scripts/migrate-sqlite-to-pg.sh --from-compose
# 注意：脚本会自动 docker compose build proxy，并挂载 ./server 使用最新代码
#
# 或使用 compose profile（proxy.db 须在 app_data 卷 /app/data/proxy.db）:
# docker compose up -d postgres
# docker compose --profile migrate run --rm migrate
# docker compose up -d
#
# 本地文件迁移:
# ./scripts/migrate-sqlite-to-pg.sh /path/to/proxy.db
# ./scripts/migrate-sqlite-to-pg.sh --local   # 本地 Python，PG 在 localhost:5432

# ── Nginx HTTPS（docker compose --profile https up -d）──────────────────────
# 绑定域名，证书放入 nginx/certs/fullchain.pem 与 privkey.pem
# DOMAIN=tokenbank.example.com
# NGINX_UPSTREAM=proxy:8000

# 可选：Gateway HTTPS（docker compose --profile gateway-https up -d）
# GATEWAY_DOMAIN=gateway.example.com
# 证书：nginx/certs/gateway-fullchain.pem、gateway-privkey.pem
# LLM 子域 llm.${GATEWAY_DOMAIN} → gateway:11430
