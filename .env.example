# Admin UI / admin API password
ADMIN_KEY=change-me-admin-key

# Per-request forward timeout (seconds)
REQUEST_TIMEOUT=120

# Default Token Bank server URL (client: desktop / CLI / Docker Web UI)
TOKEN_SERVER_URL=https://tokenbank.wink.run/

# ── Nginx HTTPS（docker compose --profile https up -d）──────────────────────
# 绑定域名，证书放入 nginx/certs/fullchain.pem 与 privkey.pem
# DOMAIN=tokenbank.example.com
# NGINX_UPSTREAM=proxy:8000

# 可选：Gateway HTTPS（docker compose --profile gateway-https up -d）
# GATEWAY_DOMAIN=gateway.example.com
# 证书：nginx/certs/gateway-fullchain.pem、gateway-privkey.pem
# LLM 子域 llm.${GATEWAY_DOMAIN} → gateway:11430

