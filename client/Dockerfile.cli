# ── Stage 1: build Vite frontend ─────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /build

# Install deps (skip electron binary download — not needed for vite build)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy only the frontend source needed for vite build
COPY index.html vite.config.js tailwind.config.js postcss.config.js ./
COPY src ./src

RUN npx vite build

# ── Stage 2: runtime — minimal npm packages (js-yaml for config-loader) ──────
FROM node:20-alpine
WORKDIR /app

# CLI entry + shared helpers
COPY cli    ./cli
COPY shared ./shared

# Gateway core modules (local-gateway.js + its dependencies)
RUN mkdir -p ./electron
COPY electron/local-gateway.js   ./electron/local-gateway.js
COPY electron/codex-transform.js ./electron/codex-transform.js
COPY electron/request-router.js  ./electron/request-router.js
COPY electron/config-loader.js   ./electron/config-loader.js
COPY electron/config             ./electron/config

# js-yaml is required by electron/config-loader.js (copy from builder to avoid npm install at runtime)
RUN mkdir -p ./node_modules
COPY --from=builder /build/node_modules/js-yaml  ./node_modules/js-yaml
COPY --from=builder /build/node_modules/argparse ./node_modules/argparse

# Pre-built Web UI (served by admin-api on :11431)
COPY --from=builder /build/dist ./dist

# Gateway :11430  |  Admin UI / API :11431
EXPOSE 11430 11431

# Config lives in /data — mount a volume or bind-mount your config directory here
ENV HOME=/data
# Override the default ~/.llm-agent path used by config-loader.js
ENV LLM_AGENT_CONFIG_DIR=/data/.llm-agent
# 默认 Token Bank 服务地址（未在 local-config.json 配置 cloud_config.url 时使用）
# ENV TOKEN_SERVER_URL=https://your-token-server.example.com

ENTRYPOINT ["node", "cli/gateway.js"]
CMD ["start"]
