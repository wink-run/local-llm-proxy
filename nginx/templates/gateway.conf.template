# 可选：本地 CLI Gateway HTTPS（需同时启用 compose profile gateway-https）
# 环境变量：GATEWAY_DOMAIN、GATEWAY_UPSTREAM（默认 gateway:11431）

map $http_upgrade $gw_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${GATEWAY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Web 管理 UI + Admin API（11431）
server {
    listen 443 ssl;
    http2 on;
    server_name ${GATEWAY_DOMAIN};

    ssl_certificate     /etc/nginx/certs/gateway-fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/gateway-privkey.pem;
    ssl_session_timeout 1d;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50m;

    location / {
        proxy_pass http://${GATEWAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

# OpenAI 兼容网关（11430）— 独立子域或同域 /v1 由客户端 BASE_URL 决定
server {
    listen 443 ssl;
    http2 on;
    server_name llm.${GATEWAY_DOMAIN};

    ssl_certificate     /etc/nginx/certs/gateway-fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/gateway-privkey.pem;
    ssl_session_timeout 1d;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    location / {
        proxy_pass http://gateway:11430;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }
}
